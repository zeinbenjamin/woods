# Copy to .env and fill in. Never commit .env.

# From https://console.anthropic.com — used only by the server, for swing analysis.
ANTHROPIC_API_KEY=sk-ant-...

# A long random string. The app sends it on every API call.
# Generate one:  openssl rand -hex 24
API_TOKEN=

# Where the database and uploaded files live. On TrueNAS use a dataset path.
DATA_PATH=/mnt/tank/apps/carry

# The uid:gid the container runs as. TrueNAS SCALE uses 568:568 (the
# `apps` user) and the dataset must be owned by it:
#   chown -R 568:568 /mnt/tank/apps/carry
# On a plain Docker host, use your own: id -u / id -g
APP_UID=568
APP_GID=568

# Optional
CARRY_MODEL=claude-sonnet-4-6
MAX_ASSET_MB=200
TZ=Australia/Sydney
